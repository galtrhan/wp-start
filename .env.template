PROJECT_NAME=wordpress
COMPOSE_PROJECT_NAME=${PROJECT_NAME}

# Database credentials
DB_HOST=mysql
DB_NAME=wordpress_db
DB_USER=wordpress_user
DB_PASSWORD=verystrongpassword

# Nginx host ports (the container always listens on 80/443). With rootless Docker, run
# ./site standard-ports once (sudo) to use 80/443 and https://your-project.local without a port.
# NGINX_HTTP_PORT=80
# NGINX_HTTPS_PORT=443

# Custom theme or plugin directories (for git hooks and dev-php.sh).
# Leave empty to auto-detect all non-default themes and plugins that have tooling files.
# THEME_NAME=my-theme
# PLUGIN_NAME=my-plugin

# Xdebug: configured in docker/php/xdebug.ini (no rebuild after ini edits; restart php).

# Production hostname for WP-CLI search-replace after ./db import (host only; set on import).
# You can paste a full URL — https://example.com/path becomes example.com.
# IMPORT_SOURCE_HOST=example.com

# Missing uploads fallback (see README). Values: off | proxy | placeholder | random_placeholder
UPLOADS_FALLBACK=off

# Required when UPLOADS_FALLBACK=proxy (no trailing slash)
REMOTE_UPLOADS_URL=https://production.example.com

# Offline placeholder: URL to download one JPG (used once; fetch again with ./site refresh-placeholder)
# PLACEHOLDER_DOWNLOAD_URL=https://picsum.photos/1200/800.jpg

# random_placeholder: photo provider for per-path redirects (needs network in the browser)
# PLACEHOLDER_PHOTO_PROVIDER=picsum
