#!/bin/bash

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/docker-env.sh
source "$REPO_ROOT/scripts/docker-env.sh"

# Configuration
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

PROJECT_NAME=${PROJECT_NAME:-"wordpress"}
DOMAIN="${PROJECT_NAME}.local"
CERTS_DIR="./certs"

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

function is_rootless_docker() {
    docker info --format '{{.SecurityOptions}}' 2>/dev/null | grep -q 'name=rootless'
}

function privileged_ports_available() {
    local start
    start=$(sysctl -n net.ipv4.ip_unprivileged_port_start 2>/dev/null || echo 1024)
    [[ "$start" -le 80 ]]
}

function configure_nginx_ports() {
    NGINX_HTTP_PORT=${NGINX_HTTP_PORT:-80}
    NGINX_HTTPS_PORT=${NGINX_HTTPS_PORT:-443}

    if is_rootless_docker && ! privileged_ports_available; then
        if [[ "$NGINX_HTTP_PORT" -lt 1024 || "$NGINX_HTTPS_PORT" -lt 1024 ]]; then
            echo -e "${YELLOW}Rootless Docker: using ports 8080 (HTTP) and 8443 (HTTPS).${NC}"
            echo -e "For the usual ${GREEN}https://${DOMAIN}${NC} URL (no port), run once: ${GREEN}./site standard-ports${NC}"
            echo "Or set NGINX_HTTP_PORT / NGINX_HTTPS_PORT in .env to keep custom ports."
            NGINX_HTTP_PORT=8080
            NGINX_HTTPS_PORT=8443
        fi
    fi

    if [[ "$NGINX_HTTPS_PORT" == "443" ]]; then
        HTTPS_REDIRECT_BASE="https://${DOMAIN}"
    else
        HTTPS_REDIRECT_BASE="https://${DOMAIN}:${NGINX_HTTPS_PORT}"
    fi

    export NGINX_HTTP_PORT NGINX_HTTPS_PORT HTTPS_REDIRECT_BASE
}

function site_url() {
    if [[ "$NGINX_HTTPS_PORT" == "443" ]]; then
        echo "https://$DOMAIN"
    else
        echo "https://$DOMAIN:$NGINX_HTTPS_PORT"
    fi
}

function enable_standard_ports() {
    local sysctl_file="/etc/sysctl.d/99-local-dev-unprivileged-ports.conf"

    if privileged_ports_available; then
        echo -e "${GREEN}Ports 80/443 are already available to rootless Docker.${NC}"
        echo "Run ${GREEN}./site restart${NC} if containers still use alternate ports."
        return 0
    fi

    echo -e "${GREEN}Allowing unprivileged binding of ports 80+ (one-time, needs sudo)...${NC}"
    echo "Rootless Docker stays enabled; this only relaxes the kernel port floor."

    run_sudo tee "$sysctl_file" > /dev/null <<'EOF'
# Local dev: allow rootless Docker to bind HTTP/HTTPS (ports >= 80).
net.ipv4.ip_unprivileged_port_start=80
EOF

    run_sudo sysctl --system >/dev/null

    if ! privileged_ports_available; then
        echo -e "${RED}Error: sysctl did not apply. Check ${sysctl_file}${NC}" >&2
        return 1
    fi

    echo -e "${GREEN}Standard ports enabled.${NC} Run ${GREEN}./site restart${NC} — site URL will be https://${DOMAIN}"
}

# Check permissions
if [ "$EUID" -eq 0 ]; then
    echo -e "${RED}Error: Please do not run this script as root/sudo.${NC}"
    echo "mkcert and project setup should be run as your regular user."
    exit 1
fi

if [[ -z "${SUDO_ASKPASS:-}" && -x "${HOME}/.config/hypr/scripts/sudo_askpass.sh" ]]; then
    export SUDO_ASKPASS="${HOME}/.config/hypr/scripts/sudo_askpass.sh"
fi

function run_sudo() {
    if [[ -n "${SUDO_ASKPASS:-}" && -x "${SUDO_ASKPASS}" ]]; then
        sudo -A "$@"
    else
        sudo "$@"
    fi
}

function port_has_listeners() {
    local port="$1"
    if [[ "$port" -lt 1024 ]]; then
        run_sudo lsof -Pi :"$port" -sTCP:LISTEN -t
    else
        lsof -Pi :"$port" -sTCP:LISTEN -t
    fi
}

function show_port_listeners() {
    local port="$1"
    if [[ "$port" -lt 1024 ]]; then
        run_sudo lsof -i :"$port"
    else
        lsof -i :"$port"
    fi
}

# Ensure current directory is owned by the current user
CURRENT_OWNER=$(stat -c '%U' .)
if [ "$CURRENT_OWNER" == "root" ]; then
    echo -e "${GREEN}Fixing directory ownership...${NC}"
    run_sudo chown -R $(whoami):$(id -gn) .
fi

function require_mkcert() {
    if ! command -v mkcert >/dev/null 2>&1; then
        echo -e "${RED}Error: mkcert is not installed.${NC}"
        echo "Install it (e.g. Arch/CachyOS: sudo pacman -S mkcert), then run: mkcert -install"
        exit 1
    fi
}

function check_ports() {
    configure_nginx_ports
    for port in "$NGINX_HTTP_PORT" "$NGINX_HTTPS_PORT"; do
        if port_has_listeners "$port" >/dev/null 2>&1; then
            echo -e "${RED}Error: Port $port is already in use.${NC}"
            echo "Please stop any other web servers or containers using this port."
            show_port_listeners "$port"
            exit 1
        fi
    done
}

function generate_certs() {
    require_mkcert
    echo -e "${GREEN}Generating wildcard certificates for $DOMAIN and *.local...${NC}"
    mkdir -p "$CERTS_DIR"
    mkcert -install
    mkcert -cert-file "$CERTS_DIR/wildcard.pem" -key-file "$CERTS_DIR/wildcard-key.pem" "$DOMAIN" "*.local"

    if [ ! -f "$CERTS_DIR/wildcard.pem" ]; then
        echo -e "${RED}Error: Certificates were not generated successfully.${NC}"
        exit 1
    fi
}

function setup_certs() {
    if [ ! -f "$CERTS_DIR/wildcard.pem" ]; then
        generate_certs
    else
         echo -e "${GREEN}Wildcard certificates already exist.${NC}"
    fi
}

function regenerate_certs() {
    echo -e "${GREEN}Regenerating SSL certificates for $DOMAIN...${NC}"
    rm -f "$CERTS_DIR/wildcard.pem" "$CERTS_DIR/wildcard-key.pem"
    generate_certs
    echo -e "${GREEN}Certificates written to $CERTS_DIR/${NC}"

    if docker compose ps --status running nginx 2>/dev/null | grep -q nginx; then
        echo -e "${GREEN}Reloading nginx to use new certificates...${NC}"
        docker compose restart nginx
    fi
}

# Windows profile folder is often NOT the same as WSL $USER.
function wsl_windows_user_profile() {
    local winname
    winname=$(powershell.exe -NoProfile -Command "[Environment]::UserName" 2>/dev/null | tr -d '\r\n')
    if [[ -n "$winname" && -d "/mnt/c/Users/$winname" ]]; then
        echo "/mnt/c/Users/$winname"
        return 0
    fi
    return 1
}

function wsl_try_copy_mkcert_root() {
    local capath profile dest dir
    capath="$(mkcert -CAROOT 2>/dev/null)/rootCA.pem"
    [[ -f "$capath" ]] || return 1
    profile=$(wsl_windows_user_profile) || return 1

    for dir in "$profile/Desktop" "$profile/Downloads"; do
        [[ -d "$dir" ]] || continue
        dest="$dir/wp-start-mkcert-root.crt"
        if cp "$capath" "$dest" 2>/dev/null; then
            echo -e "${GREEN}Copied mkcert root CA for Windows trust:${NC} $dest"
            return 0
        fi
    done
    return 1
}

function wsl_windows_browser_hint() {
    if ! grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
        return 0
    fi
    echo ""
    echo -e "${GREEN}WSL detected — open the site from a Windows browser:${NC}"
    echo "  1. Add this line to Windows hosts (Notepad as Administrator):"
    echo -e "     ${GREEN}127.0.0.1 $DOMAIN${NC}"
    echo "     File: C:\\Windows\\System32\\drivers\\etc\\hosts"
    echo "  2. Trust mkcert on Windows (same CA that signed the dev cert):"
    if wsl_try_copy_mkcert_root; then
        echo "     Double-click the .crt in Explorer → Install Certificate → Local Machine →"
    else
        echo "     Your Linux login name may differ from your Windows profile folder."
        echo "     In WSL, run (copy/paste as one block):"
        echo "     win=\$(powershell.exe -NoProfile -Command '[Environment]::UserName' | tr -d '\r\n')"
        echo "     cp \"\$(mkcert -CAROOT)/rootCA.pem\" \"/mnt/c/Users/\$win/Desktop/wp-start-mkcert-root.crt\""
        echo "     If Desktop is missing, use .../Downloads/... instead."
        echo "     On Windows: double-click the .crt → Install Certificate → Local Machine →"
    fi
    echo "     Place in \"Trusted Root Certification Authorities\"."
    echo "     If double-click does nothing: Win+R → certlm.msc → Trusted Root Certification Authorities →"
    echo "     Certificates → right-click → All Tasks → Import → select the .crt file."
    echo ""
}

function setup_hosts() {
    if ! grep -q "$DOMAIN" /etc/hosts; then
        echo -e "${GREEN}Adding $DOMAIN to /etc/hosts...${NC}"
        echo "127.0.0.1 $DOMAIN" | run_sudo tee -a /etc/hosts > /dev/null
    else
        echo -e "${GREEN}$DOMAIN already in /etc/hosts.${NC}"
    fi
}

function remote_uploads_host() {
    local url="${1%/}"
    if [[ ! "$url" =~ ^https?://[^/]+ ]]; then
        return 1
    fi
    echo "${url#*://}" | cut -d/ -f1
}

function ensure_placeholder_image() {
    if [[ ! -f "placeholder.jpg" ]]; then
        echo -e "${GREEN}Downloading offline placeholder image…${NC}"
        "$REPO_ROOT/scripts/fetch-placeholder.sh"
    fi
}

function configure_uploads_fallback() {
    UPLOADS_FALLBACK=${UPLOADS_FALLBACK:-off}
    REMOTE_UPLOADS_URL=${REMOTE_UPLOADS_URL:-}
    local out="docker/nginx/uploads-fallback.conf"

    mkdir -p docker/nginx

    case "$UPLOADS_FALLBACK" in
        proxy)
            if [[ -z "$REMOTE_UPLOADS_URL" ]]; then
                echo -e "${RED}Error: UPLOADS_FALLBACK=proxy requires REMOTE_UPLOADS_URL in .env${NC}"
                exit 1
            fi
            local remote_url="${REMOTE_UPLOADS_URL%/}"
            local remote_host
            remote_host=$(remote_uploads_host "$remote_url") || {
                echo -e "${RED}Error: REMOTE_UPLOADS_URL must be a valid http(s) URL (e.g. https://production.example.com)${NC}"
                exit 1
            }
            cat > "$out" <<EOF
# Generated by ./site from UPLOADS_FALLBACK=proxy — do not edit manually.
location ~* ^/wp-content/uploads/ {
    try_files \$uri @remote_uploads;
}

location @remote_uploads {
    proxy_pass ${remote_url};
    proxy_ssl_server_name on;
    proxy_set_header Host ${remote_host};
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
}
EOF
            echo -e "${GREEN}Uploads fallback: proxy → ${remote_url}${NC}"
            ;;
        placeholder)
            ensure_placeholder_image
            cat > "$out" <<'EOF'
# Generated by ./site from UPLOADS_FALLBACK=placeholder — do not edit manually.
location ~* ^/wp-content/uploads/ {
    try_files $uri /placeholder.jpg;
}
EOF
            echo -e "${GREEN}Uploads fallback: placeholder (offline JPG at /placeholder.jpg)${NC}"
            ;;
        random_placeholder)
            cat > "$out" <<'EOF'
# Generated by ./site from UPLOADS_FALLBACK=random_placeholder — do not edit manually.
location ~* ^/wp-content/uploads/ {
    try_files $uri @random_placeholder_uploads;
}

location @random_placeholder_uploads {
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root/placeholder-image.php;
    fastcgi_param QUERY_STRING path=$uri;
    fastcgi_pass php:9000;
}
EOF
            echo -e "${GREEN}Uploads fallback: random_placeholder (unique JPG per path via picsum.photos)${NC}"
            ;;
        off|local|none)
            cat > "$out" <<EOF
# Generated by ./site from UPLOADS_FALLBACK=off — do not edit manually.
location ~* ^/wp-content/uploads/ {
    try_files \$uri =404;
}
EOF
            echo -e "${GREEN}Uploads fallback: off (local files only)${NC}"
            ;;
        *)
            echo -e "${RED}Error: UPLOADS_FALLBACK must be one of: off, proxy, placeholder, random_placeholder${NC}"
            exit 1
            ;;
    esac
}

function setup_env() {
    echo -e "${GREEN}Creating .env interactively from .env.template...${NC}"
    while IFS= read -u 3 -r line || [[ -n "$line" ]]; do
        if [[ $line =~ ^[[:space:]]*# ]] || [[ -z "$line" ]]; then
            echo "$line" >> .env
        elif [[ $line =~ ^([^=]+)=(.*)$ ]]; then
            key="${BASH_REMATCH[1]}"
            default_value="${BASH_REMATCH[2]}"
            read -p "$key [$default_value]: " user_input
            value=${user_input:-$default_value}
            echo "$key=$value" >> .env
        else
            echo "$line" >> .env
        fi
    done 3< .env.template
    echo -e "${GREEN}.env file created successfully.${NC}"
}

case "$1" in
    setup)
        echo -e "${GREEN}Starting WordPress Local Environment Setup...${NC}"
        
        if [ ! -f .env ]; then
            setup_env
        else
            echo -e "${GREEN}.env file already exists.${NC}"
        fi
        
        echo -e "${GREEN}Building Docker images...${NC}"
        docker compose build

        configure_uploads_fallback

        if [ ! -f index.php ]; then
            echo -e "${GREEN}Initializing WordPress project...${NC}"
            docker compose run --rm php sh -c "curl -sO https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && chmod +x wp-cli.phar && php -d memory_limit=512M ./wp-cli.phar core download --allow-root"
            
            echo -e "${GREEN}Fixing project ownership...${NC}"
            run_sudo chown -R $(whoami):$(id -gn) .
            
            echo -e "${GREEN}Creating wp-config.php...${NC}"
            cat <<EOF > wp-config.php
<?php
define( 'DB_NAME', getenv('DB_NAME') );
define( 'DB_USER', getenv('DB_USER') );
define( 'DB_PASSWORD', getenv('DB_PASSWORD') );
define( 'DB_HOST', getenv('DB_HOST') );
define( 'DB_CHARSET', 'utf8' );
define( 'DB_COLLATE', '' );

\$table_prefix = 'wp_';
define( 'WP_DEBUG', true );

if ( ! defined( 'ABSPATH' ) ) {
	define( 'ABSPATH', __DIR__ . '/' );
}

define( 'FS_METHOD', 'direct' );

require_once ABSPATH . 'wp-settings.php';
EOF
        else
            echo -e "${GREEN}WordPress project already initialized (index.php exists).${NC}"
        fi

        echo -e ""
        echo -e "${GREEN}Setup complete!${NC}"
        echo -e "You can now start the environment with: ${GREEN}./site start${NC}"
        ;;
    start)
        if [ ! -f "index.php" ]; then
            echo -e "${RED}Error: index.php not found.${NC}"
            echo "Please run ./site setup first to initialize the WordPress project."
            exit 1
        fi

        if [ "$(docker compose ps --format json | grep -c "running")" -gt 0 ]; then
            echo -e "${GREEN}Site is already running. Restarting...${NC}"
            docker compose down
        fi

        echo -e "${GREEN}Starting site...${NC}"
        configure_nginx_ports
        check_ports
        setup_hosts
        setup_certs
        configure_uploads_fallback
        docker compose up -d
        echo -e "${GREEN}Site is available at $(site_url)${NC}"
        wsl_windows_browser_hint
        ;;
    stop)
        echo -e "${GREEN}Stopping site...${NC}"
        docker compose down
        ;;
    restart)
        $0 stop
        $0 start
        ;;
    rebuild)
        echo -e "${GREEN}Rebuilding Docker images...${NC}"
        docker compose build --no-cache
        echo -e "${GREEN}Build complete. Use ./site start to launch.${NC}"
        ;;
    certs)
        regenerate_certs
        ;;
    standard-ports)
        enable_standard_ports
        ;;
    refresh-placeholder)
        "$REPO_ROOT/scripts/fetch-placeholder.sh" --force
        configure_uploads_fallback
        if docker compose ps --status running nginx 2>/dev/null | grep -q nginx; then
            docker compose exec -T nginx nginx -s reload 2>/dev/null || docker compose restart nginx
        fi
        ;;
    reset)
        echo -e "${RED}Danger: This will remove all WordPress files, database, and local certificates to reset the boilerplate.${NC}"
        read -p "Are you sure you want to continue? (y/N) " confirm
        if [[ $confirm == [yY] || $confirm == [yY][eE][sS] ]]; then
            echo -e "${GREEN}Cleaning up environment...${NC}"
            
            echo -e "${GREEN}Stopping project containers...${NC}"
            docker compose down -v || true
            
            configure_nginx_ports
            for port in "$NGINX_HTTP_PORT" "$NGINX_HTTPS_PORT"; do
                if port_has_listeners "$port" >/dev/null 2>&1; then
                    echo -e "${RED}Warning: Something is still using port $port.${NC}"
                    read -p "Would you like to stop ALL running docker containers to free up ports? (y/N) " stop_all
                    if [[ $stop_all == [yY] ]]; then
                        docker stop $(docker ps -q) || true
                    fi
                    break
                fi
            done

            if grep -q "$DOMAIN" /etc/hosts; then
                echo -e "${GREEN}Removing $DOMAIN from /etc/hosts...${NC}"
                run_sudo sed -i "/$DOMAIN/d" /etc/hosts
            fi

            echo -e "${GREEN}Removing project files and certificates...${NC}"
            run_sudo rm -rf .env certs/ placeholder.jpg wp-admin/ wp-content/ wp-includes/ wp-config.php index.php license.txt readme.html wp-activate.php wp-blog-header.php wp-comments-post.php wp-cron.php wp-links-opml.php wp-load.php wp-login.php wp-mail.php wp-settings.php wp-signup.php wp-trackback.php xmlrpc.php composer.json composer.lock vendor/ wp-cli.phar wp-config-sample.php
            
            echo -e ""
            echo -e "${GREEN}Note: Project-specific certificates have been removed.${NC}"
            echo -e "The mkcert Root CA remains installed in your system trust store."
            echo -e "To find its location: ${GREEN}mkcert -CAROOT${NC}"
            echo -e "To completely uninstall the Root CA: ${RED}mkcert -uninstall${NC}"
            echo -e ""
            
            echo -e "${GREEN}Cleanup complete! Project is back to clean boilerplate state.${NC}"
        else
            echo -e "Cleanup cancelled."
        fi
        ;;
    *)  
        echo "Usage: $0 {setup|start|stop|restart|rebuild|certs|standard-ports|refresh-placeholder|reset}"
        exit 1
        ;;
esac
    