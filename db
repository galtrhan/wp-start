#!/bin/bash

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/docker-env.sh
source "$REPO_ROOT/scripts/docker-env.sh"

# Database import/export utility script
# This script manages database operations for the WordPress development environment

# Configuration
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

PROJECT_NAME=${PROJECT_NAME:-"wordpress"}
DOMAIN="${PROJECT_NAME}.local"
DB_HOST=${DB_HOST:-"mysql"}
DB_NAME=${DB_NAME:-"wordpress"}
DB_USER=${DB_USER:-"wordpress"}
DB_PASSWORD=${DB_PASSWORD:-"wordpress"}

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# Check if site is running
function is_site_running() {
    docker compose ps --format json 2>/dev/null | grep -q "running" && return 0 || return 1
}

# Start the site if not running
function ensure_site_running() {
    if ! is_site_running; then
        echo -e "${YELLOW}Site is not running. Starting...${NC}"
        ./site start

        # Wait for MySQL to be ready
        echo -e "${YELLOW}Waiting for database to be ready...${NC}"
        for i in {1..30}; do
            if docker compose exec -T mysql mysql -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASSWORD" -e "SELECT 1" &>/dev/null; then
                echo -e "${GREEN}Database is ready.${NC}"
                return 0
            fi
            sleep 1
        done
        echo -e "${RED}Database failed to become ready.${NC}"
        return 1
    fi
}

# Export database to SQL file
function export_db() {
    local filename="${1:-dump.sql}"

    if ! ensure_site_running; then
        echo -e "${RED}Error: Could not start site.${NC}"
        exit 1
    fi

    echo -e "${GREEN}Exporting database to $filename...${NC}"

    docker compose exec -T mysql mysqldump \
        --no-tablespaces \
        -h "$DB_HOST" \
        -u "$DB_USER" \
        -p"$DB_PASSWORD" \
        "$DB_NAME" > "$filename"

    if [ $? -eq 0 ]; then
        echo -e "${GREEN}Database exported successfully to $filename${NC}"
    else
        echo -e "${RED}Error: Failed to export database.${NC}"
        exit 1
    fi
}

function mysql_query() {
    docker compose exec -T mysql mysql -N -h "$DB_HOST" -u "$DB_USER" -p"$DB_PASSWORD" "$DB_NAME" -e "$1" 2>/dev/null
}

# Detect WordPress table prefix from imported database (e.g. h7QG9_ from h7QG9_posts).
function detect_table_prefix() {
    local tables table prefix

    tables=$(mysql_query "SHOW TABLES")
    if [[ -z "$tables" ]]; then
        return 1
    fi

    while IFS= read -r table; do
        [[ "$table" == *_posts ]] || continue
        prefix="${table%posts}"
        if ! echo "$tables" | grep -qx "${prefix}options"; then
            continue
        fi
        if mysql_query "SELECT 1 FROM \`${prefix}options\` WHERE option_name='siteurl' LIMIT 1" | grep -q 1; then
            printf '%s' "$prefix"
            return 0
        fi
    done <<< "$tables"

    while IFS= read -r table; do
        [[ "$table" == *_posts ]] || continue
        prefix="${table%posts}"
        if echo "$tables" | grep -qx "${prefix}options"; then
            printf '%s' "$prefix"
            return 0
        fi
    done <<< "$tables"

    return 1
}

function sync_wp_config_table_prefix() {
    local prefix="$1"
    local config="$REPO_ROOT/wp-config.php"

    if [[ ! -f "$config" ]]; then
        echo -e "${RED}Error: wp-config.php not found. Run ./site setup first.${NC}" >&2
        return 1
    fi

    if grep -qE '\$table_prefix\s*=' "$config"; then
        sed -i "s/\$table_prefix = '[^']*';/\$table_prefix = '${prefix}';/" "$config"
    else
        echo -e "${RED}Error: could not find \$table_prefix in wp-config.php.${NC}" >&2
        return 1
    fi
}

function sync_table_prefix_after_import() {
    local prefix

    if ! prefix=$(detect_table_prefix); then
        echo -e "${YELLOW}Warning: could not detect WordPress table prefix; WP-CLI may fail.${NC}"
        echo -e "${YELLOW}Set \$table_prefix in wp-config.php to match the imported database.${NC}"
        return 1
    fi

    if ! sync_wp_config_table_prefix "$prefix"; then
        return 1
    fi

    echo -e "${GREEN}Updated wp-config.php table prefix to '${prefix}'${NC}"
}

# Replace production hostnames with the local dev domain (WP-CLI search-replace).
function normalize_import_source_host() {
    local input="$1"
    input="${input#"${input%%[![:space:]]*}"}"
    input="${input%"${input##*[![:space:]]}"}"
    input="${input#http://}"
    input="${input#https://}"
    input="${input#//}"
    input="${input%%/*}"
    input="${input%%\?*}"
    input="${input%%#*}"
    input="${input%.}"
    printf '%s' "$(echo "$input" | tr '[:upper:]' '[:lower:]')"
}

function save_import_source_host_to_env() {
    local host="$1"
    local env_file="$REPO_ROOT/.env"

    if [[ ! -f "$env_file" ]]; then
        touch "$env_file"
    fi

    if grep -q '^IMPORT_SOURCE_HOST=' "$env_file" 2>/dev/null; then
        grep -v '^IMPORT_SOURCE_HOST=' "$env_file" > "${env_file}.tmp"
        mv "${env_file}.tmp" "$env_file"
    fi

    echo "IMPORT_SOURCE_HOST=${host}" >> "$env_file"
    export IMPORT_SOURCE_HOST="$host"
}

function prompt_import_source_host() {
    local default normalized

    default=$(normalize_import_source_host "${IMPORT_SOURCE_HOST:-}")
    if [[ -n "$default" ]]; then
        read -p "Import source host [${default}]: " user_input
        if [[ -z "$user_input" ]]; then
            normalized="$default"
        else
            normalized=$(normalize_import_source_host "$user_input")
        fi
    else
        read -p "Import source host: " user_input
        normalized=$(normalize_import_source_host "$user_input")
    fi

    if [[ -z "$normalized" ]]; then
        echo -e "${RED}Error: import source host is required.${NC}" >&2
        exit 1
    fi

    save_import_source_host_to_env "$normalized"
    echo -e "${GREEN}Saved IMPORT_SOURCE_HOST=${normalized} to .env${NC}"
}

function search_replace_urls() {
    local auto_yes="${1:-0}"
    local local_host="${PROJECT_NAME}.local"
    local local_url="https://${local_host}"
    local source_host

    prompt_import_source_host
    source_host="$IMPORT_SOURCE_HOST"

    echo ""
    echo -e "${YELLOW}URLs in the database may still reference ${source_host}.${NC}"
    echo -e "Proposed WP-CLI search-replace (--all-tables):"
    echo -e "  https://${source_host} → ${local_url}"
    echo -e "  http://${source_host} → ${local_url}"
    echo -e "  //${source_host} → ${local_url}"
    echo -e "  ${source_host} → ${local_host}"

    if [[ "$auto_yes" != "1" ]]; then
        read -p "Run search-replace now? (y/N) " confirm
        if [[ ! $confirm =~ ^[yY]$ ]]; then
            echo "Search-replace skipped."
            return 0
        fi
    fi

    echo -e "${GREEN}Running search-replace...${NC}"

    local from to
    local replacements=(
        "https://${source_host}|${local_url}"
        "http://${source_host}|${local_url}"
        "//${source_host}|${local_url}"
        "${source_host}|${local_host}"
    )

    for pair in "${replacements[@]}"; do
        from="${pair%%|*}"
        to="${pair#*|}"
        echo -e "  ${from} → ${to}"
        if ! "$REPO_ROOT/scripts/wp.sh" --allow-root search-replace "$from" "$to" --all-tables; then
            echo -e "${RED}Error: search-replace failed for ${from}.${NC}"
            exit 1
        fi
    done

    echo -e "${GREEN}Search-replace complete. Current URLs:${NC}"
    "$REPO_ROOT/scripts/wp.sh" --allow-root option get siteurl
    "$REPO_ROOT/scripts/wp.sh" --allow-root option get home
}

# Import database from SQL file
function import_db() {
    local filename="$1"
    local auto_search_replace="${2:-0}"

    if [ -z "$filename" ]; then
        echo -e "${RED}Error: No SQL file specified.${NC}"
        echo "Usage: $0 import [-y] <filename.sql>"
        exit 1
    fi

    if [ ! -f "$filename" ]; then
        echo -e "${RED}Error: File '$filename' not found.${NC}"
        exit 1
    fi

    if ! ensure_site_running; then
        echo -e "${RED}Error: Could not start site.${NC}"
        exit 1
    fi

    echo -e "${YELLOW}Importing database from $filename...${NC}"
    read -p "This will replace the current database. Are you sure? (y/N) " confirm

    if [[ ! $confirm =~ ^[yY]$ ]]; then
        echo "Import cancelled."
        exit 0
    fi

    docker compose exec -T mysql mysql \
        -h "$DB_HOST" \
        -u "$DB_USER" \
        -p"$DB_PASSWORD" \
        "$DB_NAME" < "$filename"

    if [ $? -eq 0 ]; then
        echo -e "${GREEN}Database imported successfully from $filename${NC}"
    else
        echo -e "${RED}Error: Failed to import database.${NC}"
        exit 1
    fi

    sync_table_prefix_after_import

    search_replace_urls "$auto_search_replace"
}

# Show usage
function show_usage() {
    cat <<EOF
Database management utility for WordPress development environment

Usage: $0 {export|import|sync-prefix|search-replace} [options] [filename]

Commands:
  export [filename]          Export database to SQL file (default: dump.sql)
  import [-y] <filename>     Import database from SQL file
  sync-prefix                Detect table prefix from DB and update wp-config.php
  search-replace [-y]        Run URL search-replace using saved import source host

Options:
  -y, --yes                  Run URL search-replace after import without prompting
                             (import itself still requires confirmation)

Examples:
  $0 export                         # Export to dump.sql
  $0 export backup.sql              # Export to backup.sql
  $0 import backup.sql              # Import; then prompt for search-replace
  $0 import -y backup.sql           # Import; then search-replace automatically

Notes:
  - The site will automatically start if not running
  - Database credentials are loaded from .env file
  - Import requires confirmation before proceeding
  - After import, detects the WordPress table prefix and updates wp-config.php
  - Prompts for import source host (pre-filled from IMPORT_SOURCE_HOST in .env)
  - Strips https://, paths, etc. from the source host and saves it to .env
  - Replaces https, http, protocol-relative, and bare host variants in the database
EOF
}

# Main
case "$1" in
    export)
        export_db "$2"
        ;;
    sync-prefix)
        ensure_site_running || exit 1
        sync_table_prefix_after_import
        ;;
    search-replace)
        shift
        auto_yes=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -y|--yes) auto_yes=1; shift ;;
                *) show_usage; exit 1 ;;
            esac
        done
        ensure_site_running || exit 1
        sync_table_prefix_after_import || true
        search_replace_urls "$auto_yes"
        ;;
    import)
        shift
        auto_search_replace=0
        filename=""

        while [[ $# -gt 0 ]]; do
            case "$1" in
                -y|--yes)
                    auto_search_replace=1
                    shift
                    ;;
                -*)
                    echo -e "${RED}Error: Unknown option '$1'.${NC}"
                    show_usage
                    exit 1
                    ;;
                *)
                    if [ -n "$filename" ]; then
                        echo -e "${RED}Error: Unexpected argument '$1'.${NC}"
                        show_usage
                        exit 1
                    fi
                    filename="$1"
                    shift
                    ;;
            esac
        done

        import_db "$filename" "$auto_search_replace"
        ;;
    *)
        show_usage
        exit 1
        ;;
esac
